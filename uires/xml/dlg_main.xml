<SOUI name="mainWindow" title="@string/title" bigIcon="ICON_LOGO:32" smallIcon="ICON_LOGO:16" width="300" height="600" resizable="1" sendWheel2Hover="1" wndType="appMain" appWnd="1" translucent="1">
    <root skin="" cache="1">
        <window pos="0dp,0dp,-0dp,-0dp" cache="1">
             <window  colorBkgnd="#cdcccc">
                <caption  font="adding:2" pos="0,0,-0,32dp" colorBkgnd="#0694F3" show="1">
                    <caption gravity="center" layout="hbox" height="32dp" >
                        <img valign="middle" skin="img_logo" size="20dp, 20dp" extend_left="6dp" />
                        <text valign="middle" extend_left="4dp" colorText="#ffffff" >@string/title</text>
                    </caption>
                    <imgbtn animate="1" name="btn_close" pos="-32dp,1dp" skin="_skin.btn.close" tip="close" cursor="hand"/>
                    <!--<imgbtn animate="1" name="btn_max" pos="{-32dp,1dp" display="0" skin="_skin.btn.max" cursor="hand"/>-->
                    <!--<imgbtn animate="1" name="btn_restore" pos="{-32dp,1dp" show="0" display="0" skin="_skin.btn.restore" cursor="hand"/>-->
                    <imgbtn animate="1" name="btn_min" pos="{-32dp,1dp" skin="_skin.btn.min" cursor="hand"/>
                    <imgbtn animate="1" name="btn_set" pos="{-32dp,1dp" skin="_skin.btn.set" cursor="hand"/>
                    <!--<imgbtn animate="1" name="btn_msg" pos="{-32dp,1dp" show="1" display="0" skin="_skin.btn.msg" cursor="hand"/>-->
                </caption>
                <window pos="0dp,[0dp,-0,-0" colorBkgnd="#ffffff"  margin="1dp, 0, 1dp, 1dp">
                    <tabctrlex name="tab_main" pos="0,0,-0,-0" tabHeight="0">
                        <page title="page_home">
                            <include src="LAYOUT:page_home"/>
                        </page>
                        <page title="page_setting">
                            <include src="LAYOUT:page_setting"/>
                        </page>
                        <page title="page_about">
                            <include src="LAYOUT:page_about"/>
                        </page>
                        <pageTemplate>
                            <page>
                                <include src="LAYOUT:page_detail"/>
                            </page>
                        </pageTemplate>
                    </tabctrlex>
                </window>
                <window pos="0,-45dp,-0,-0" colorBkgnd="#ffffff" margin="1dp,0dp,1dp,1dp" show="0" display="0">

                </window>
            </window>
        </window>
        <Turn3dView name="turn3d" pos="0,0,-0,-0"/>
    </root>
</SOUI>
